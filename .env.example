# PropertyPulse environment variables
#
# The running MVP uses a built-in client-side mock data store (see lib/store.tsx)
# seeded from supabase/seed.sql, so NO env vars are required to run `npm run dev`.
#
# These are reserved for wiring the app to a real Supabase backend (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
