# PropertyPulse environment variables
#
# WITHOUT these set, the app runs fine using local browser storage (no setup).
#
# SET these two to turn on cloud sync (data persists & syncs across devices).
# See SUPABASE_SETUP.md for the full walkthrough.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for the future full secure backend (Auth + per-table RLS). Not used
# by the simple cloud-sync mode.
SUPABASE_SERVICE_ROLE_KEY=
